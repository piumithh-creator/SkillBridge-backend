PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/skillbridge
JWT_ACCESS_SECRET=replace-with-a-long-random-string-1
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string-2
GEMINI_API_KEY=
CLIENT_URL=http://localhost:5173
NODE_ENV=development

# Optional
GEMINI_MODEL=gemini-3.5-flash
# Tried in order if the main model is retired/unavailable (comma-separated)
GEMINI_FALLBACK_MODELS=gemini-2.5-flash-lite
# GEMINI_TEMPERATURE=   (leave unset to use the model default)
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
UPLOAD_DIR=uploads
# Used only by `npm run seed:admin`
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=
ADMIN_PASSWORD=
